{
  "general": {
    "displayTitle": "Pepsi",
    "internalSlug": "pepsi",
    "author": {
      "person": {
        "firstName": "Giorgi",
        "lastName": "Kavrelishvili"
      },
      "organization": {}
    },
    "projectVersion": "1.0.0-alpha"
  },
  "windowBase": {
    "width": 1280,
    "height": 800,
    "clearColor": "#F4C2C2"
  },
  "environments": {
    "development": {
      "windowOverrides": {
        "isFullscreen": false,
        "isBorderlessFullscreen": false,
        "alwaysOnTop": false,
        "transparent": false,
        "useNativeResolution": false,
        "useVsync": true
      },
      "scriptingEngine": {
        "runtime": {
          "maxHeapSizeMb": 128,
          "stackSizeKb": 1024,
          "gcThresholdKb": 512,
          "interruptHandler": 50
        },
        "features": {
          "enableBytecodeCache": false,
          "enableProxy": true
        },
        "interop": {
          "printToStandardOut": true,
          "verbosity": "detailed"
        }
      }
    },
    "production": {
      "windowOverrides": {
        "isFullscreen": true,
        "isBorderlessFullscreen": true,
        "alwaysOnTop": true,
        "transparent": false,
        "useNativeResolution": true,
        "useVsync": true
      },
      "scriptingEngine": {
        "runtime": {
          "maxHeapSizeMb": 64,
          "stackSizeKb": 512,
          "gcThresholdKb": 256,
          "interruptHandler": 10
        },
        "features": {
          "enableBytecodeCache": true,
          "enableProxy": false
        },
        "interop": {
          "printToStandardOut": false,
          "verbosity": "silent"
        }
      }
    }
  },
  "metaData": {}
}
